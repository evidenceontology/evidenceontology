    <!-- http://purl.obolibrary.org/obo/ECO_0000241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000059"/>
        <obo:IAO_0000115>A type of experimental phenotypic evidence resulting from modification to the surroundings or conditions in which an organism lives or operates.</obo:IAO_0000115>
