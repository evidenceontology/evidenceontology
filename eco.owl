            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A transcription profiling assay that is performed using a very low amount (nanogram scale) of mRNA samples using Cap analysis gene expression (CAGE).</obo:IAO_0000115>
        <rdfs:label>nano-cap analysis of gene expression assay</rdfs:label>
    </owl:Class>
    


