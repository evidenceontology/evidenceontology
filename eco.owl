        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000002"/>
        <obo:IAO_0000115>A type of direct assay evidence where the activity of a solution is determined by exposing an indicator culture or organism to a series of dilutions and determining the lowest concentration that elicits a biological response.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>critical dilution assay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spot assay</oboInOwl:hasExactSynonym>
        <rdfs:comment>For chemicals, bacteriocins, or phage, the indicator culture is typically present in a soft-agar layer on top of nutrient agar and a small quantity of each dilution is spotted onto the soft agar overlay.</rdfs:comment>
        <rdfs:label xml:lang="en">dilution assay evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0005800"/>
