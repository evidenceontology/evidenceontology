        <obo:IAO_0000115>An in-situ hybridization assay that uses fluorescence to detect chromosomal integrity</obo:IAO_0000115>
        <rdfs:label>chromosome organization assay by fluorescence in-situ hybridization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001684 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
