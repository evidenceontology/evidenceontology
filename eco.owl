        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of anatomical perturbation phenotypic evidence resulting from the surgical removal of tissue or subcellular components.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:MCC</oboInOwl:hasDbXref>
