                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000406"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>reverse transcribe pcr is a process which allow amplification of cDNA during a pcr reaction while the cDNA results from a retrotranscription of messenger RNA isolated from a material entity.</obo:IAO_0000115>
        <rdfs:label>reverse transcribed polymerase chain reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000576">
