    <!-- http://purl.obolibrary.org/obo/ECO_0001563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0001563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001565"/>
