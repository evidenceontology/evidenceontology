    <!-- http://purl.obolibrary.org/obo/ECO_0000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000156"/>
        <obo:IAO_0000115>A type of protein separation evidence that is followed by direct protein sequencing whereby a protein&apos;s amino acid sequence is determined experimentally by Edman degradation or by mass spectrometry.</obo:IAO_0000115>
