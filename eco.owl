        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0006259</oboInOwl:id>
        <rdfs:label>Raman spectroscopy evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of spectrophotometry evidence used to determine a structural fingerprint of the molecule in solution by probing its vibrational modes via the inelastic scattering of photons (called Raman scattering).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Raman_spectroscopy</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0006260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0006268"/>
        <obo:IAO_0000115>A type of temperature-induced protein unfolding evidence that assess thermal denaturation temperature and protein stability under different experimental conditions, e.g. buffer pH or ionic strength, redox potential, usually by means of intrinsic fluorescence or thermofluor.</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:BalintMeszaros</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym>TSA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0006260</oboInOwl:id>
        <rdfs:label>protein thermal shift assay evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of temperature-induced protein unfolding evidence that assess thermal denaturation temperature and protein stability under different experimental conditions, e.g. buffer pH or ionic strength, redox potential, usually by means of intrinsic fluorescence or thermofluor.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Thermal_shift_assay</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0006261 -->

