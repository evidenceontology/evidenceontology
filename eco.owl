        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of fluorescence evidence used to assess the formation of amyloid fibrils indicated by an increase in Thioflavin T fluorescence intensity and a characteristic red shift in the emission spectrum upon binding to amyloids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/34431623/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


