        <oboInOwl:hasRelatedSynonym>protein separation and direct sequencing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECO:0000158</oboInOwl:id>
        <rdfs:label>protein separation followed by direct sequencing evidence</rdfs:label>
    </owl:Class>
    


