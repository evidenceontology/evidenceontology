        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of mutant phenotype evidence where a phenotype is associated with altered gene product which lacks the molecular function of the wild-type gene.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>SO:0002054</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000017">
