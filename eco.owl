    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000361"/>
        <obo:IAO_0000112>Responsive donors expressing the HLA-DQ6 allele showed an increased level of proliferation to the epitope as compared to peptide-responsive HLA-DQ6 negative donors [PMID:14735143].</obo:IAO_0000112>
        <obo:IAO_0000115>A type of inferential evidence that employs the association of specific MHC molecule expression by a subject population with a T cell response to infer that T cells can recognize the ligand when presented by that MHC molecule.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB:RandiVita</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-06-09T05:36:49Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>Statistically inferred by motif or alleles present</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008082</oboInOwl:id>
        <rdfs:label>inference of MHC restriction based on shared MHC expression</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of inferential evidence that employs the association of specific MHC molecule expression by a subject population with a T cell response to infer that T cells can recognize the ligand when presented by that MHC molecule.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>IEDB:RandiVita</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000002"/>
        <obo:IAO_0000112>Determining that the PBMC response to peptide HSV-1 gD 0-14 is HLA class II restricted because proliferation was the response type that was measured [PMID:8503783].</obo:IAO_0000112>
        <obo:IAO_0000115>A type of direct assay evidence that employs the type of T cell epitope assay to determine that a specific ligand is restricted by a MHC molecule or class of MHC molecules.</obo:IAO_0000115>
