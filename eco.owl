        <obo:IAO_0000115>A type of direct assay evidence where electrical properties of cells or tissues are studied.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0000164</oboInOwl:id>
