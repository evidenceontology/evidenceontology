        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/OBI_0000681"/>
        <obo:IAO_0000115>A material separation objective aiming to separate material into multiple portions, each of which contains a similar composition of the input material.</obo:IAO_0000115>
        <rdfs:label>portioning objective</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000681 -->

