                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A protein that is a translation product of the Escherichia coli K-12 ligA gene or a 1:1 ortholog thereof.</obo:IAO_0000115>
        <rdfs:label>DNA ligase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000025471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000025471">
