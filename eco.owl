        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OBSOLETE. A type of chromosome conformation capture evidence that is derived by performing polymerase chain reaction (PCR) in the quantitation step.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:MCC</oboInOwl:hasDbXref>
    </owl:Axiom>
    


