            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A type of chromosome conformation-based evidence that is derived by performing ligation-mediated amplification (LMA) prior to product quantitation.</obo:IAO_0000115>
        <oboInOwl:created_by>mchibucos</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-11-19T01:22:20Z</oboInOwl:creation_date>
