    <!-- http://purl.obolibrary.org/obo/ECO_0008010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0008000"/>
        <obo:IAO_0000115>A type of machine learning method evidence that uses a supervised learning model with associated algorithms for classification. Support vector machines aim to determine a hyperplane that separates two classes while maximizing the distance from the hyperplane to any given data point in those classes.</obo:IAO_0000115>
        <obo:IAO_0000234>AGR:KimberlyVanAuken</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
