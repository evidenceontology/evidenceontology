        </rdfs:subClassOf>
        <obo:IAO_0000115>A study design that investigates the features of interaction between molecules.</obo:IAO_0000115>
        <rdfs:label>molecular interaction identification design</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002619 -->

