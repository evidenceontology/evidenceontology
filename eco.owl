            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A study design in which sequencing technology (e.g. Solexa/454) is used to generate RNA sequence, analyse the transcibed regions of the genome, and/or to quantitate transcript abundance</obo:IAO_0000115>
        <rdfs:label>transcription profiling by high throughput sequencing design</rdfs:label>
    </owl:Class>
    


