        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of match to sequence model evidence resulting from a positive match of a protein, or set of proteins to a predictive model (signature) in the InterPro database.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMC:PMC2686546</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/mesh?term=Nucleic+Acid+Hybridization</oboInOwl:hasDbXref>
    </owl:Axiom>
    


