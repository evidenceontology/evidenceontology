                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A assay detecting a molecular label assay in which the label is attached to an antibody so that substances are marked based on the antibody&apos;s binding specificity.</obo:IAO_0000115>
        <rdfs:label>immuno staining assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001633">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
