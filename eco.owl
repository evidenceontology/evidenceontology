        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0006256"/>
        <obo:IAO_0000115>A type of protein fragment functional complementaion evidence where the interaction between bait and prey assemble a functional beta galactosidase enzyme.</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:BalintMeszaros</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
