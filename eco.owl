    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0005550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0005549"/>
        <obo:IAO_0000115>A type of  biological system reconstruction evidence based on homology evidence where the evidence is inferred by paralogy from an existing experimentally supported model to a process, pathway, or complex in the same species.</obo:IAO_0000115>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
