        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001237"/>
        <obo:ECO_9000002>EXP</obo:ECO_9000002>
        <obo:IAO_0000115>A type of natural variation mutant evidence used in manual assertion where alleles are directly linked to phenotype and Mendelian diseases as a result of various experiments.</obo:IAO_0000115>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2016-04-12T17:24:00Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>IAGP</oboInOwl:hasExactSynonym>
