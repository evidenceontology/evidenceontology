        <oboInOwl:id>ECO:0006258</oboInOwl:id>
        <rdfs:label>GAL4-VP16 functional complementation evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of protein fragment functional complementaion evidence where the interaction between bait and prey assemble a transcriptional activation complex consisting of the GAL4 DNA-binding domain and the transactivation domain from the herpes simplex virus protein VP16.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MI:0728</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0006259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001126"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0005031"/>
        <obo:IAO_0000115>A type of spectrophotometry evidence used to determine a structural fingerprint of the molecule in solution by probing its vibrational modes via the inelastic scattering of photons (called Raman scattering).</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:BalintMeszaros</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
