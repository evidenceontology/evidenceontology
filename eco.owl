        </rdfs:subClassOf>
        <obo:IAO_0000115>A device manufacture with the intent to provide a porous unsized paper used for filtering.</obo:IAO_0000115>
        <rdfs:label>filter paper</rdfs:label>
    </owl:Class>
    


