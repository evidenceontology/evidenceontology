        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006253"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of magnetic resonance evidence in which unpaired electrons in a strong constant magnetic field are perturbed by a weak oscillating magnetic field and the resulting electromagnetic signal is captured.</owl:annotatedTarget>
