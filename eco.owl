    <!-- http://purl.obolibrary.org/obo/ECO_0000337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0600051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
