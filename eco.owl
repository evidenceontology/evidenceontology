    <!-- http://purl.obolibrary.org/obo/ECO_0008183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000002"/>
        <obo:IAO_0000115>A type of direct assay evidence in which proteins of interest are fused to an enzyme that is able to label or modify other proteins that come into the proximity of the protein of interest. Labeled/modified proteins are then isolated and identified, often by mass spectrometry.</obo:IAO_0000115>
        <obo:IAO_0000234>KAUST:RohitSatyam</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-04-05T15:56:13Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008183</oboInOwl:id>
        <rdfs:label>protein proximity labeling assay evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of direct assay evidence in which proteins of interest are fused to an enzyme that is able to label or modify other proteins that come into the proximity of the protein of interest. Labeled/modified proteins are then isolated and identified, often by mass spectrometry.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31161514</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0008183"/>
        <obo:IAO_0000115>A type of protein proximity labeling assay evidence in which a mutant of a biotin protein ligase is fused to a protein of interest such that when other proteins enter the proximity of the protein of interest they are biotinylated. Biotinylated proteins are then isolated and identified, often by mass spectrometry.</obo:IAO_0000115>
        <obo:IAO_0000234>KAUST:RohitSatyam</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-04-05T15:56:13Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>BioID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008184</oboInOwl:id>
        <rdfs:label>proximity-dependent biotin identification evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008184"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of protein proximity labeling assay evidence in which a mutant of a biotin protein ligase is fused to a protein of interest such that when other proteins enter the proximity of the protein of interest they are biotinylated. Biotinylated proteins are then isolated and identified, often by mass spectrometry.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31161514</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000021"/>
        <obo:IAO_0000115>A type of physical interaction evidence that is the accumulated strength of multiple affinities of individual non-covalent binding interactions, such as between a protein receptor and its ligand. Avidity should not be thought of as the mere sum of its constituent affinities but as the combined effect of all affinities participating in the biomolecular interaction. It is commonly referred to as functional affinity.</obo:IAO_0000115>
        <obo:IAO_0000234>KAUST:RohitSatyam</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-04-05T15:56:13Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008185</oboInOwl:id>
        <rdfs:label>avidity evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of physical interaction evidence that is the accumulated strength of multiple affinities of individual non-covalent binding interactions, such as between a protein receptor and its ligand. Avidity should not be thought of as the mere sum of its constituent affinities but as the combined effect of all affinities participating in the biomolecular interaction. It is commonly referred to as functional affinity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Avidity</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0008185"/>
        <obo:IAO_0000115>A type of avidity evidence in which immobilized &quot;bait&quot; proteins are probed with enzyme-tagged, multimerized &quot;prey&quot; proteins to amplify avidity, enabling sensitive detection of otherwise weak and transient extracellular protein-protein interactions.</obo:IAO_0000115>
        <obo:IAO_0000234>KAUST:RohitSatyam</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-04-05T15:56:13Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>AVEXIS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008186</oboInOwl:id>
        <rdfs:label>avidity-based extracellular interaction screening evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008186"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of avidity evidence in which immobilized &quot;bait&quot; proteins are probed with enzyme-tagged, multimerized &quot;prey&quot; proteins to amplify avidity, enabling sensitive detection of otherwise weak and transient extracellular protein-protein interactions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22414956</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001048"/>
        <obo:IAO_0000115>A type of fluorescence resonance energy transfer evidence resulting from the measurement of the distance-dependent energy transfer of two fluorophores attached to individual molecules, allowing for the detection of conformational states at both spatial and temporal resolution.</obo:IAO_0000115>
        <obo:IAO_0000234>XimeAixa</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2026-04-05T15:56:13Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>smFRET evidence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008187</oboInOwl:id>
        <rdfs:label>single-molecule fluorescence resonance energy transfer evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008187"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of fluorescence resonance energy transfer evidence resulting from the measurement of the distance-dependent energy transfer of two fluorophores attached to individual molecules, allowing for the detection of conformational states at both spatial and temporal resolution.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:36183447</oboInOwl:hasDbXref>
    </owl:Axiom>
    


