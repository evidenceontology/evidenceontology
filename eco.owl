        <oboInOwl:id>ECO:0008085</oboInOwl:id>
        <rdfs:label>specific MHC molecule based MHC restriction evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of direct assay evidence that employs the use of a specific MHC molecule in a T cell response assay to determine that a specific ligand is restricted by that MHC molecule.</owl:annotatedTarget>
