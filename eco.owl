    <!-- http://purl.obolibrary.org/obo/ECO_0005543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0005543">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ECO_0005552"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ECO_9000000"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECO_0000218"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0005552"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0007747"/>
        <obo:ECO_9000002>EXP</obo:ECO_9000002>
        <obo:IAO_0000115>A type of biological system reconstruction evidence by experimental evidence from mixed species that is used in a manual assertion.</obo:IAO_0000115>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-12-16T15:45:01Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0005543</oboInOwl:id>
        <rdfs:comment>Inference is made primarily on functional conservation between the two systems. The sequences and number of genome-encoded components are fairly conserved but some divergence is observed. The evidence may originate from a combination of several experiments.</rdfs:comment>
        <rdfs:label>biological system reconstruction evidence by experimental evidence from mixed species used in manual assertion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0005543"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/ECO_0007747"/>
        <oboInOwl:is_inferred>true</oboInOwl:is_inferred>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0005543"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of biological system reconstruction evidence by experimental evidence from mixed species that is used in a manual assertion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:SN</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:22232657</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0005544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0005544">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
