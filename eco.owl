        <oboInOwl:id>ECO:0000236</oboInOwl:id>
        <rdfs:comment>See 3C evidence.  3C evidence was initially developed using PCR.</rdfs:comment>
        <rdfs:label>obsolete chromosome conformation capture-PCR evidence</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
