        <oboInOwl:id>ECO:0005608</oboInOwl:id>
        <rdfs:label>tumble frequency assay evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0005608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of chemotaxis assay evidence where the presence or absence of positive or negative chemotaxis in swimming organisms is determined by measuring chemotaxis in response to sudden concentration changes from one uniform spatial environment to another.</owl:annotatedTarget>
