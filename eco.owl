        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000057"/>
        <obo:IAO_0000115>A type of phenotypic similarity evidence that is based on the categorization of genes by the similarity of expression profiles.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>IGES</oboInOwl:hasExactSynonym>
