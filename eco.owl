        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-06-09T05:36:49Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>T cell assay -Biological process measured</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008083</oboInOwl:id>
        <rdfs:label>T cell epitope assay type based MHC restriction evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of direct assay evidence that employs the type of T cell epitope assay to determine that a specific ligand is restricted by a MHC molecule or class of MHC molecules.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>IEDB:RandiVita</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000024"/>
        <obo:IAO_0000112>Cry j 2-stimulated T-cell proliferation was inhibited by anti-HLA-DR, but not by anti-HLA-DQ antibody, indicating that the responding T cells recognized the allergen peptides associated with HLA-DR molecules [PMID:8899114].</obo:IAO_0000112>
        <obo:IAO_0000115>A type of protein binding evidence that employs the specific blocking of MHC molecules to determine that a ligand is restricted by that MHC molecule or class of MHC molecules.</obo:IAO_0000115>
        <obo:IAO_0000234>IEDB:RandiVita</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2024-06-09T05:36:49Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>T cell assay -MHC subset identification</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008084</oboInOwl:id>
        <rdfs:label>MHC-specific blocking based MHC restriction evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008084"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of protein binding evidence that employs the specific blocking of MHC molecules to determine that a ligand is restricted by that MHC molecule or class of MHC molecules.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>IEDB:RandiVita</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000002"/>
        <obo:IAO_0000112>Determining that the T cell response to peptide MTB Ag85 232-240 is restricted by HLA-B*15:01 because T cells bound to tetramers containing only HLA-B*15:01 presenting that peptide [PMID: 17429413].</obo:IAO_0000112>
        <obo:IAO_0000115>A type of direct assay evidence that employs the use of a specific MHC molecule in a T cell response assay to determine that a specific ligand is restricted by that MHC molecule.</obo:IAO_0000115>
