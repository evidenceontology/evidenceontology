        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A material entity that has two or more specimens as its parts.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">collection of specimens</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <obo:IAO_0000115>An assay that detects expression of a reporter gene that was inserted under the control of a regulatory sequence of interest.</obo:IAO_0000115>
        <rdfs:label>reporter gene assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002089 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002089">
