    <!-- http://purl.obolibrary.org/obo/ECO_0006191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001126"/>
        <obo:IAO_0000115>A type of spectrophotometry evidence resulting from the evaluation of a molecule in a fluid or solid state by its ability to alter the transmission of infrared light, where the raw data collected is transformed into the specturm by Fourier transform.</obo:IAO_0000115>
