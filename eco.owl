                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">a genetic transformation which relies on the use of physical, electrical and chemical phenomena to introduce DNA or RNA into a cell</obo:IAO_0000115>
        <rdfs:label xml:lang="en">transfection</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000456"/>
        <obo:IAO_0000115 xml:lang="en">a material transformation objective aims to create genetically modified organism or cell</obo:IAO_0000115>
        <rdfs:label xml:lang="en">genetic transformation objective</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600043"/>
        <obo:IAO_0000115 xml:lang="en">A genetic transformation that is the modification of the genetic material (either coding or non-coding) of an organism caused by mutagenic processes, compounds, or irradiation.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">induced mutagenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001155">
