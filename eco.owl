        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of electron microscopy evidence where the sample being studied has been cooled to cryogenic temperatures (typically below -153 degrees Celsius) prior to the experiment.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31078399</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Cryogenic_electron_microscopy</oboInOwl:hasDbXref>
