        <obo:ECO_9000002>ISA</obo:ECO_9000002>
        <obo:IAO_0000115>A type of transcript splice pattern evidence that is based on the exon combination of a coding sequence (CDS), a sub-feature of a whole transcript, and is used in manual assertion.</obo:IAO_0000115>
        <oboInOwl:created_by>mchibucos</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-06-08T11:43:47Z</oboInOwl:creation_date>
