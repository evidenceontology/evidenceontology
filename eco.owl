        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Electron_paramagnetic_resonance</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0006254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0006253"/>
        <obo:IAO_0000115>A type of electron paramagnetic resonance evidence where the signal is obtained by labeling the protein in specific sites with a functional group (most often a nitroxide) containing an unpaired electron using site-directed mutagenesis.</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:BalintMeszaros</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym>SDSL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0006254</oboInOwl:id>
        <rdfs:label>site-directed spin-labelling electron paramagnetic resonance evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006254"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of electron paramagnetic resonance evidence where the signal is obtained by labeling the protein in specific sites with a functional group (most often a nitroxide) containing an unpaired electron using site-directed mutagenesis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:21826602</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Site-directed_spin_labeling</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0006255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000002"/>
        <obo:IAO_0000115>A type of direct assay evidence where the removal of glycan groups from a substrate (RNA, DNA, or protein) is detected.</obo:IAO_0000115>
