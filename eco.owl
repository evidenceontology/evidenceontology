    <!-- http://purl.obolibrary.org/obo/ECO_0006338 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001115"/>
        <obo:IAO_0000115>A type of fluorescence evidence where the rates of fast chemical reactions in a solution are measured by the intensity of light absorbed or fluoresced by allowing the reaction mixture to come to an equilibrium, and then perturbing the equilibrium by a rapid temperature rise followed by relaxation of the system to the new equilibrium.</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:EdoardoSalladini</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0006338</oboInOwl:id>
        <rdfs:label>temperature jump relaxation evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of fluorescence evidence where the rates of fast chemical reactions in a solution are measured by the intensity of light absorbed or fluoresced by allowing the reaction mixture to come to an equilibrium, and then perturbing the equilibrium by a rapid temperature rise followed by relaxation of the system to the new equilibrium.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Temperature_jump</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://iopscience.iop.org/article/10.1088/0022-3735/16/12/003</oboInOwl:hasDbXref>
    </owl:Axiom>
    


