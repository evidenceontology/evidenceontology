        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5632530/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000162 -->

