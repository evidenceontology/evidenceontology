    <!-- http://purl.obolibrary.org/obo/ECO_0006333 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001115"/>
        <obo:IAO_0000115>A type of fluorescence evidence used to assess the formation of amyloid fibrils indicated by an increase in Thioflavin T fluorescence intensity and a characteristic red shift in the emission spectrum upon binding to amyloids.</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:FedericaQuaglia</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym>ThT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ThT assay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ThT fluorescence assay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0006333</oboInOwl:id>
        <rdfs:label>thioflavin T based fluorescence spectroscopy evidence</rdfs:label>
