                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A protein complex that possesses DNA polymerase activity and is involved in template directed synthesis of DNA.</obo:IAO_0000115>
        <rdfs:label>DNA polymerase complex</rdfs:label>
    </owl:Class>
    


