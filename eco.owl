        <obo:IAO_0000115>Excretion that is the output of a kidney</obo:IAO_0000115>
        <rdfs:label>urine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000463"/>
        <obo:IAO_0000115>Liquid components of living organisms. includes fluids that are excreted or secreted from the body as well as body water that normally is not.</obo:IAO_0000115>
        <rdfs:label>bodily fluid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000002 -->

