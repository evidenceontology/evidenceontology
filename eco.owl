        <oboInOwl:creation_date>2010-11-15T12:22:40Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>DNA sequencing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECO:0000219</oboInOwl:id>
        <rdfs:label>nucleotide sequencing assay evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of sequencing assay that determines the sequence of a biopolymer comprised of nucleotides.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:MCC</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000219"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
