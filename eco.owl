        <oboInOwl:id>ECO:0008013</oboInOwl:id>
        <rdfs:label>neural network method evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of machine learning method evidence in which the machine learning model consists of nodes connected to each other with edges that are organized into layers, where the edges can transmit signals between nodes such that the system acts similarly to biological neurons.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Artificial_neural_network</oboInOwl:hasDbXref>
    </owl:Axiom>
    


