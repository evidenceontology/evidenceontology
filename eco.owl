        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0006163"/>
        <obo:IAO_0000115>A type of nuclear magnetic resonance spectroscopy evidence based on two-dimensional NMR for elucidation of the chemical structure of an isolated or synthesized chemical compound where the characteristic transfer magnetization of a proton to a nitrogen or carbon isotope is monitored by NMR, generating a specific peak in the spectrum.</obo:IAO_0000115>
        <obo:IAO_0000234>CollecTF</obo:IAO_0000234>
        <oboInOwl:created_by>swolfish</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-11-03T14:11:06Z</oboInOwl:creation_date>
