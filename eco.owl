        <oboInOwl:id>ECO:0000038</oboInOwl:id>
        <rdfs:label>transient rescue experiment evidence</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000039 -->

