    <!-- http://purl.obolibrary.org/obo/ECO_0001052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0001052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000325"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0002116"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>No OD increases with the mutant and the wild type were measured with DMSO provided as electron acceptor at 2 and 10 mM; however, HPLC analyses of cultures with 2 mM DMSO revealed that DMSO was completely consumed in wild type cultures, whereas no DMSO consumption was evident in the mutant cultures (Figure 3).</obo:IAO_0000112>
        <obo:IAO_0000115>A type of chromatography evidence resulting from the separation of molecules in a solute by forcing the solvent containing the sample through a column packed with nonporous particles at high pressure.</obo:IAO_0000115>
        <oboInOwl:created_by>mchibucos</oboInOwl:created_by>
        <oboInOwl:creation_date>2014-03-16T11:30:54Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>HPLC evidence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0001052</oboInOwl:id>
        <rdfs:label>high-performance liquid chromatography evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0001052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>No OD increases with the mutant and the wild type were measured with DMSO provided as electron acceptor at 2 and 10 mM; however, HPLC analyses of cultures with 2 mM DMSO revealed that DMSO was completely consumed in wild type cultures, whereas no DMSO consumption was evident in the mutant cultures (Figure 3).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:21450087</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0001052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of chromatography evidence resulting from the separation of molecules in a solute by forcing the solvent containing the sample through a column packed with nonporous particles at high pressure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16376355</oboInOwl:hasDbXref>
    </owl:Axiom>
    


