        <oboInOwl:hasDbXref>OBI:0000626</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000006"/>
        <obo:IAO_0000115>A type of experimental evidence where the order of molecules that constitute a biopolymer is determined.</obo:IAO_0000115>
