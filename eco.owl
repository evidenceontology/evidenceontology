        <rdfs:label>assay measuring a binding constant of a T cell epitope:MHC:TCR complex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002075">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000070"/>
                    <owl:Restriction>
