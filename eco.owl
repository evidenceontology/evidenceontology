        <oboInOwl:id>ECO:0000059</oboInOwl:id>
        <rdfs:comment>Observable characteristic traits can be morphology, development, behavior, biochemical or physiological properties, etc.</rdfs:comment>
        <rdfs:label>experimental phenotypic evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000059"/>
