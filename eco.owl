    <!-- http://purl.obolibrary.org/obo/ECO_0006247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0005516"/>
        <obo:IAO_0000115>A type of molecule detection assay evidence where the hydrodynamic behaviour of macromolecules is used to study their size, shape and interactions, by spinning the sample solution at high centrifugal field (up to above 100000 rpm and 1000000 g), and monitoring the evolution of sample concentration profile versus the axis of rotation.</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:FedericaQuaglia</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
