    <!-- http://purl.obolibrary.org/obo/ECO_0000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000082">
        <obo:IAO_0000115>OBSOLETE. A type of experimental genomic evidence where DNA polymerase is used to synthesize new strand of DNA complementary to the offered template strand.</obo:IAO_0000115>
