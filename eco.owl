        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0005610"/>
        <obo:ECO_9000002>ISS</obo:ECO_9000002>
        <obo:IAO_0000115>A type of  biological system reconstruction evidence based on paralogy evidence that is used in a manual assertion.</obo:IAO_0000115>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-12-16T16:05:15Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0005546</oboInOwl:id>
        <rdfs:comment>Inference is made primarily on functional conservation between the two systems. The sequences and number of genome-encoded components are fairly conserved but some divergence is observed. Evidence may originate from a combination of several experiments.</rdfs:comment>
        <rdfs:label>biological system reconstruction evidence based on paralogy evidence used in manual assertion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0005546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of  biological system reconstruction evidence based on paralogy evidence that is used in a manual assertion.</owl:annotatedTarget>
