        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0007672"/>
        <obo:IAO_0000115>A type of similarity based on biomolecular sequence.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0000044</oboInOwl:id>
        <rdfs:comment>A sequence similarity analysis may involve a gene or a gene product, and it could be based on similarity to a single other gene or to a group of other genes.</rdfs:comment>
        <rdfs:label>sequence similarity evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000044"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
