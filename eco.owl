    <!-- http://purl.obolibrary.org/obo/ECO_0008013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0008000"/>
        <obo:IAO_0000115>A type of machine learning method evidence in which the machine learning model consists of nodes connected to each other with edges that are organized into layers, where the edges can transmit signals between nodes such that the system acts similarly to biological neurons.</obo:IAO_0000115>
        <obo:IAO_0000234>AGR:KimberlyVanAuken</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
