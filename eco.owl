        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006350"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of molecule detection assay evidence in which the detection of the interaction between molecules is done without the use of labels and is instead based on the phase shift-wavelength correlation created between interference patterns off of two unique surfaces on the tip of a biosensor, where the ligand is immobilized onto a bio compatible biosensor while the analyte is in solution.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Bio-layer_interferometry</oboInOwl:hasDbXref>
    </owl:Axiom>
    


