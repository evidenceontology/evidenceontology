    <!-- http://purl.obolibrary.org/obo/ECO_0005552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0005552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0005551"/>
        <obo:IAO_0000115>A type of biological system reconstruction evidence where the experimental evidence is derived by using a mix of species used in the same experiment.</obo:IAO_0000115>
