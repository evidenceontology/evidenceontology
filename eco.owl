        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000156"/>
        <obo:IAO_0000115>A type of protein separation evidence which then utilizes the screening and identification of small-molecules that bind to proteins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>protein separation and fragment identification</oboInOwl:hasRelatedSynonym>
