        <oboInOwl:id>ECO:0000174</oboInOwl:id>
        <rdfs:comment>Examples include: abnormal growth of the root in response to gravity, delay in flowering in response to varying light conditions.</rdfs:comment>
        <rdfs:label>mutant physiological response evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
