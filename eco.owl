    <!-- http://purl.obolibrary.org/obo/ECO_0001589 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0001589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001098"/>
        <obo:IAO_0000112>AFM revealed loop structures stabilized by multiple EspR dimer of dimers suggesting the presence of several distant EspR binding sites in the espACD upstream region.</obo:IAO_0000112>
        <obo:IAO_0000115>A type of microscopy evidence where a mechanical probe is applied to a sample (i.e. a type of scanning probe microscopy) which can result in production of an image (with resolution in the order of fractions of a nanometer), force measurement, or sample manipulation.</obo:IAO_0000115>
        <obo:IAO_0000234>CollecTF</obo:IAO_0000234>
        <oboInOwl:created_by>jbmunro</oboInOwl:created_by>
        <oboInOwl:creation_date>2019-04-15T12:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>AFM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SFM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>scanning force microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0001589</oboInOwl:id>
        <rdfs:comment>Atomic force microscopy can be used for force measurement (force spectroscopy), imaging (rendering a three-dimensional shape (topography), and manipulation of the sample.</rdfs:comment>
        <rdfs:label>atomic force microscopy evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>AFM revealed loop structures stabilized by multiple EspR dimer of dimers suggesting the presence of several distant EspR binding sites in the espACD upstream region.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22479184</oboInOwl:hasDbXref>
    </owl:Axiom>
    


