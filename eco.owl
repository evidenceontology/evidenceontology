    <!-- http://purl.obolibrary.org/obo/ECO_0000066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000025"/>
