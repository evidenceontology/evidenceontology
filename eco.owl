    <!-- http://purl.obolibrary.org/obo/ECO_0000355 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000080"/>
        <obo:IAO_0000115>A type of phylogenetic evidence characterized by the mapping of the character states of living organisms onto phylogenies using the method of maximum parsimony.</obo:IAO_0000115>
        <oboInOwl:created_by>mchibucos</oboInOwl:created_by>
        <oboInOwl:creation_date>2014-04-22T17:02:31Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0000355</oboInOwl:id>
        <rdfs:comment>Example of use: &quot;The presence of paired evaginated hemispheres and olfactory bulbs in both agnathan and gnathostome radiations suggests that such hemispheres were also present in the common ancestor.&quot; PMID:7013637. Northcutt RG. (1981) Evolution of the telencephalon in nonmammals. Ann. Rev. Neurosci.</rdfs:comment>
        <rdfs:label>phylogenetic distribution evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000355"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
