    <!-- http://purl.obolibrary.org/obo/ECO_0000360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000006"/>
        <obo:IAO_0000115>A type of experimental evidence resulting from the prediction of drug-target interactions by computational means.</obo:IAO_0000115>
        <oboInOwl:created_by>mchibucos</oboInOwl:created_by>
        <oboInOwl:creation_date>2014-09-26T16:39:11Z</oboInOwl:creation_date>
