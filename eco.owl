    <!-- http://purl.obolibrary.org/obo/ECO_0000084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000177"/>
        <obo:IAO_0000115>A type of genomic context evidence in which a gene product&apos;s identity is supported on the basis of the identity of neighboring genes.</obo:IAO_0000115>
