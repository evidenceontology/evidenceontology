        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000639"/>
        <obo:IAO_0000115>A material separation objective aiming to separate a material entity that has parts of different types, and end with at least one output that is a material with parts of fewer types (modulo impurities).</obo:IAO_0000115>
        <rdfs:label>separation into different composition objective</rdfs:label>
    </owl:Class>
    


