        <obo:IAO_0000115 xml:lang="en">is the transplantation of living cells, tissues or \norgans from one species to another such as from pigs to humans</obo:IAO_0000115>
        <rdfs:label xml:lang="en">xenotransplantation</rdfs:label>
    </owl:Class>
    


