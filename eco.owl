        <rdfs:label>beta galactosidase functional complementation evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0006257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of protein fragment functional complementaion evidence where the interaction between bait and prey assemble a functional beta galactosidase enzyme.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:9237989</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0006258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0006258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0006256"/>
        <obo:IAO_0000115>A type of protein fragment functional complementaion evidence where the interaction between bait and prey assemble a transcriptional activation complex consisting of the GAL4 DNA-binding domain and the transactivation domain from the herpes simplex virus protein VP16.</obo:IAO_0000115>
        <obo:IAO_0000234>DisProt:BalintMeszaros</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
