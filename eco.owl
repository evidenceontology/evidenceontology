        <owl:annotatedTarget>MI:0004</owl:annotatedTarget>
        <rdfs:label>affinity chromatography technology</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000080 -->

