        <oboInOwl:hasDbXref>PMID:19958477</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0001669"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A type of physical interaction evidence that is based on detection of protein-protein interactions by separation of target proteins by SDS-PAGE which are blotted to a membrane, followed by denaturation and renaturation, probing with purified bait proteins, and detection of the target-bait complexes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MI:0047</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>far-Western analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECO:0000076</oboInOwl:id>
        <rdfs:comment>The interacting protein is referenced in the evidence_with column.</rdfs:comment>
        <rdfs:label>far-Western blotting evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of physical interaction evidence that is based on detection of protein-protein interactions by separation of target proteins by SDS-PAGE which are blotted to a membrane, followed by denaturation and renaturation, probing with purified bait proteins, and detection of the target-bait complexes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18079728</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0000077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0001065"/>
