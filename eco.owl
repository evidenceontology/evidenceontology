            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_1110128"/>
        <obo:IAO_0000115>An immune epitope assay that characterizes the structrue of a MHC-ligand complex, or detects the processing and presentation of a ligand by an antigen presenting cell, or the binding of a ligand to an MHC molecule.</obo:IAO_0000115>
        <rdfs:label>MHC ligand assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002076">
