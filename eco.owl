        <obo:IAO_0000115>An analytical chromatography assay that utilizes a high performance liquid chromatography instrument for separation of compounts in a solution.</obo:IAO_0000115>
        <rdfs:label>high performance liquid chromotography assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002119">
