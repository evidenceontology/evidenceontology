        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000361"/>
        <obo:IAO_0000115>A type of inferential evidence in which sequence features are inferred based on visual inspection of the sequence.</obo:IAO_0000115>
        <oboInOwl:created_by>beckyjackson</oboInOwl:created_by>
        <oboInOwl:creation_date>2019-11-22T06:51:00Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0007850</oboInOwl:id>
        <rdfs:comment>This type of inference may be made by either a curator or an author.</rdfs:comment>
        <rdfs:label>inference of sequence features from visual inspection</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0007850"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of inferential evidence in which sequence features are inferred based on visual inspection of the sequence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:RCJ</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0007672"/>
        <obo:IAO_0000115>A type of computational evidence in which computational systems build models based on sample data, known as training data, in order to make predictions or decisions without being explicitly programmed to do so. Such systems are trained on a combination of existing data about an entity, and are applied to the generation of new labels, such as numerical or textual or categorical.</obo:IAO_0000115>
        <obo:IAO_0000234>UniProt:AlexIgnatchenk</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:ElenaSperetta</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:PedroRaposo</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:VishalJoshi</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-04-07T05:36:49Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008000</oboInOwl:id>
        <rdfs:label>machine learning method evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of computational evidence in which computational systems build models based on sample data, known as training data, in order to make predictions or decisions without being explicitly programmed to do so. Such systems are trained on a combination of existing data about an entity, and are applied to the generation of new labels, such as numerical or textual or categorical.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Machine_learning</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0008013"/>
        <obo:IAO_0000115>A type of neural network method evidence which leverages a broad suite of neural network models, which use a combination of data attributes of an entity called features as inputs, and map them to outputs through multiple layers of connected hidden units, whose parameters are learned from data.</obo:IAO_0000115>
        <obo:IAO_0000234>UniProt:AlexIgnatchenk</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:ElenaSperetta</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:PedroRaposo</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:VishalJoshi</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-04-07T05:36:49Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008001</oboInOwl:id>
        <rdfs:label>deep learning neural network method evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of neural network method evidence which leverages a broad suite of neural network models, which use a combination of data attributes of an entity called features as inputs, and map them to outputs through multiple layers of connected hidden units, whose parameters are learned from data.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Deep_learning</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://storage.googleapis.com/brain-genomics-public/research/proteins/protnlm/uniprot_2022_04/protnlm_preprint_draft.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.uniprot.org/help/ProtNLM</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ECO_0008002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0008002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0008000"/>
        <obo:IAO_0000115>A type of machine learning method evidence which uses a combination of data attributes to derive knowledge used to create a set of rules. These rules collectively represent the prediction model and are in the form of &quot;IF:THEN&quot; statements. The knowledge applied can be traced back to the rules and the original data.</obo:IAO_0000115>
        <obo:IAO_0000234>UniProt:AlexIgnatchenk</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:ElenaSperetta</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:PedroRaposo</obo:IAO_0000234>
        <obo:IAO_0000234>UniProt:VishalJoshi</obo:IAO_0000234>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2023-04-07T05:36:49Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008002</oboInOwl:id>
        <rdfs:label>rule-based machine learning method evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of machine learning method evidence which uses a combination of data attributes to derive knowledge used to create a set of rules. These rules collectively represent the prediction model and are in the form of &quot;IF:THEN&quot; statements. The knowledge applied can be traced back to the rules and the original data.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UniProt:VishalJoshi</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://borgelt.net/apriori.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.uniprot.org/help/arba</oboInOwl:hasDbXref>
    </owl:Axiom>
    


