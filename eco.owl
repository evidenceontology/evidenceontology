        <obo:ECO_9000002>EXP</obo:ECO_9000002>
        <obo:IAO_0000115>A type of biological system reconstruction evidence by experimental evidence from single species that is used in a manual assertion.</obo:IAO_0000115>
        <oboInOwl:created_by>snadendla</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-12-16T15:32:41Z</oboInOwl:creation_date>
