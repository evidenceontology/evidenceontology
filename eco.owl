                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001146"/>
        <obo:IAO_0000115>A binding assay in which the heat generated or absorbed during a binding event is measured, which allows determination of binding constants, reaction stoichiometry, enthalpy and entropy.</obo:IAO_0000115>
        <rdfs:label>calorimetric binding assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001979"/>
