        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0008010</oboInOwl:id>
        <rdfs:label>support vector machine evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0008010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of machine learning method evidence that uses a supervised learning model with associated algorithms for classification. Support vector machines aim to determine a hyperplane that separates two classes while maximizing the distance from the hyperplane to any given data point in those classes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.nature.com/articles/nbt1206-1565</oboInOwl:hasDbXref>
    </owl:Axiom>
    


