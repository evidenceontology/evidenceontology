        <oboInOwl:hasExactSynonym>carbon-copy 3C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>carbon-copy chromosome conformation capture evidence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0000235</oboInOwl:id>
        <rdfs:comment>5C is used to study the structural properties and spatial organization of chromosomes inside cells. Like other types of chromosome conformation capture technology, 5C differs only in the fifth step, which involves ligation-mediated amplification (LMA) followed by product quantitation.</rdfs:comment>
        <rdfs:label>5C evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0000235"/>
