            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
        <obo:IAO_0000115>A material entity that is generated by a purification process in which an input material is separated to obtain a fraction with a higher concentration of a desired component</obo:IAO_0000115>
        <rdfs:label>purified material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001634">
