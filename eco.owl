        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_1110022"/>
        <obo:IAO_0000115>An immunoglobulin complex that is present in the plasma membrane of B cells and that in its canonical form is composed of two identical immunoglobulin heavy chains and two identical immunoglobulin light chains and a signaling subunit, a heterodimer of the Ig-alpha and Ig-beta proteins.</obo:IAO_0000115>
        <rdfs:label>B cell receptor complex</rdfs:label>
    </owl:Class>
    


