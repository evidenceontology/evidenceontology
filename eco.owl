        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of microscopy evidence where antibodies are used to detect the location of molecules or other structures within cells or tissues.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ECO:MCC</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ECO:SN</oboInOwl:hasDbXref>
