    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0001056">
        <obo:IAO_0000115>OBSOLETE. A type of genetic transformation evidence resulting from a mutation induced by a mutagenic compounds or irradiation.</obo:IAO_0000115>
