    <!-- http://purl.obolibrary.org/obo/ECO_0000038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000012"/>
        <obo:IAO_0000115>A type of functional complementation evidence resulting from the introduction of nucleic acids, which are not permanently incorporated into the genome, to temporarily prevent, or &quot;rescue&quot; an organism from a condition.</obo:IAO_0000115>
