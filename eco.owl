        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001034"/>
        <obo:IAO_0000115>A container with an environmental control function.</obo:IAO_0000115>
        <rdfs:label>physical store</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0002090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000552"/>
        <obo:IAO_0000115 xml:lang="en">A reverse transcribed polymerase chain reaction that is used to amplify a mRNA sequence between a defined internal site and the 5&apos; or 3&apos; end of the mRNA.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">rapid amplification of cDNA ends</rdfs:label>
    </owl:Class>
    


