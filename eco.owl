        <oboInOwl:id>ECO:0005521</oboInOwl:id>
        <rdfs:label>S1 nuclease protection assay evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ECO_0005521"/>
