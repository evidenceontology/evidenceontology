    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECO_0000202"/>
        <obo:IAO_0000115>A type of match to sequence model evidence resulting from a positive match of a protein, or set of proteins to a predictive model (signature) in the InterPro database.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0000029</oboInOwl:id>
        <rdfs:label>match to InterPro member signature evidence</rdfs:label>
    </owl:Class>
