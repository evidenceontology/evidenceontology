        <obo:IAO_0000115>A type of sequence alignment evidence resulting from the comparison of a single exon transcript to a collection / database of known single exon genes.</obo:IAO_0000115>
        <oboInOwl:created_by>mchibucos</oboInOwl:created_by>
        <oboInOwl:creation_date>2013-04-03T05:10:34Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>eco</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ECO:0000345</oboInOwl:id>
        <rdfs:label>single exon transcript confirmation via alignment evidence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
